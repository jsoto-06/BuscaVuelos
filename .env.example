# ===============================================================
# Configuración de Vuelos Baratos (Amadeus for Developers API)
# ===============================================================

# Credenciales de Amadeus (Obligatorias para buscar vuelos)
# Obtén tus claves gratuitas en: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=tu_client_id_aqui
AMADEUS_CLIENT_SECRET=tu_client_secret_aqui

# Clave opcional de SerpApi para Google Flights en vivo
# Obtén tu clave en: https://serpapi.com/
SERPAPI_API_KEY=tu_serpapi_key_aqui

# Entorno de Amadeus: 'test' para pruebas gratuitas, 'prod' para producción
AMADEUS_ENV=test

# Moneda preferida (ISO 4217, p. ej. EUR, USD, GBP)
MONEDA=EUR

# Aeropuerto de origen por defecto (código IATA de 3 letras)
ORIGEN_POR_DEFECTO=BIO

# Aeropuertos alternativos cercanos (separados por comas)
# Se usarán al indicar el flag --alternativos en la búsqueda
ALTERNATIVOS_ORIGEN=VIT,SDR,BIQ

# Intervalo mínimo de cortesía en segundos entre peticiones HTTP (respeto de rate limit)
MIN_SEGUNDOS_ENTRE_PETICIONES=2

# Proxy opcional (dejar vacío si no se usa proxy, ej. http://127.0.0.1:8080)
PROXY_URL=

# Intervalo en horas para la comprobación periódica en modo 'vigilar'
INTERVALO_VIGILANCIA_HORAS=6

# Activar notificaciones de escritorio del sistema si la librería está disponible (true | false)
NOTIFICAR_SISTEMA=true
